{
  "name": "hufs-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply hufs_room --local",
    "db:seed:local": "node scripts/gen-seed.mjs && wrangler d1 execute hufs_room --local --file=seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply hufs_room --remote",
    "db:seed:remote": "node scripts/gen-seed.mjs && wrangler d1 execute hufs_room --remote --file=seed/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "test": "node scripts/api-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  }
}
